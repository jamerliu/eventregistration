# Supabase — find these in Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # keep secret — server-only, never exposed to the browser

# Restrict sign-up to your school's email domain (checked before an account is even
# created — see components/AuthForm.tsx)
NEXT_PUBLIC_SCHOOL_DOMAIN="yourschool.edu"

# Comma-separated list of emails that should have admin access
ADMIN_EMAILS="[email protected],[email protected]"

# No email service needed — the app shows registration status in-app, and admins can
# export email addresses by outcome to notify people manually via their own inbox
# (see the "Copy emails to notify manually" section on each event's admin page).
